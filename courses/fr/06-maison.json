      "learn": [
        {"title": "Kde bydlíš?", "blocks": [
          {"type": "text", "cs": "U domu a bytu se používá *dans*: *J'habite dans une maison.* (Bydlím v domě.) *J'habite dans un appartement.* (Bydlím v bytě.)"},
          {"type": "table", "firstCs": true, "rows": [
            ["kuchyně", "la cuisine"], ["obývák", "le salon"], ["koupelna", "la salle de bains"], ["záchod", "les toilettes"],
            ["jídelna", "la salle à manger"], ["pokoj (ložnice)", "la chambre"], ["zahrada", "le jardin"], ["balkon", "le balcon"], ["garáž", "le garage"]
          ]},
          {"type": "tip", "title": "les toilettes", "cs": "*Les toilettes* jsou vždy v množném čísle, i když je záchod jen jeden."}
        ]},
        {"title": "Patra", "blocks": [
          {"type": "text", "cs": "Přízemí je *le rez-de-chaussée*. Patra se počítají řadovými číslovkami: *au premier étage* (v 1. patře), *au deuxième étage* (ve 2. patře). Řadovou číslovku vytvoříš přidáním *-ième*: *deux → deuxième, trois → troisième*. Jen první je *premier / première*."},
          {"type": "table", "firstCs": true, "rows": [["1.", "premier / première"], ["2.", "deuxième"], ["3.", "troisième"], ["4.", "quatrième"], ["5.", "cinquième"], ["9.", "neuvième"], ["10.", "dixième"]]},
          {"type": "tip", "title": "Pravopis", "cs": "Koncové *-e* odpadá: *quatre → quatrième*. U pětky přibude *u*: *cinq → cinquième*. U devítky se *f* mění na *v*: *neuf → neuvième*."},
          {"type": "check", "item": {"type": "cloze", "fr": "J'habite au ___ étage.", "a": ["deuxième"], "hint": "2."}}
        ]},
        {"title": "Slovíčka", "blocks": [{"type": "vocab"}]}
      ],
      "practice": [
        {"id": "fr-6-1-01", "type": "cloze", "fr": "J'habite ___ un appartement.", "a": ["dans"]},
