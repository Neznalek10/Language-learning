      "learn": [
        {"title": "Il y a", "blocks": [
          {"type": "text", "cs": "*Il y a* znamená „je, jsou, nachází se“ a nemění se podle čísla: *Dans ma chambre, il y a un lit.* (V mém pokoji je postel.) *Il y a deux fenêtres.* (Jsou tam dvě okna.)"},
          {"type": "text", "cs": "Zápor je *il n'y a pas de*: *Il n'y a pas de télé.* (Není tam televize.) Otázka: *Est-ce qu'il y a un balcon ?* nebo *Qu'est-ce qu'il y a dans ta chambre ?*"},
          {"type": "examples", "items": [
            {"fr": "Dans le salon, il y a un canapé et une table.", "cs": "V obýváku je gauč a stůl."},
            {"fr": "Il n'y a pas de garage.", "cs": "Není tam garáž."},
            {"fr": "Qu'est-ce qu'il y a dans ta chambre ?", "cs": "Co je v tvém pokoji?"}
          ]},
          {"type": "check", "item": {"type": "cloze", "fr": "Dans ma chambre, ___ un lit.", "a": ["il y a"], "hint": "je"}}
        ]},
        {"title": "Nábytek", "blocks": [
          {"type": "table", "firstCs": true, "rows": [
            ["postel", "le lit"], ["stůl", "la table"], ["židle", "la chaise"], ["psací stůl", "le bureau"], ["skříň", "l'armoire"],
            ["police", "l'étagère"], ["lampa", "la lampe"], ["koberec", "le tapis"], ["zrcadlo", "le miroir"], ["gauč", "le canapé"],
            ["okno", "la fenêtre"], ["dveře", "la porte"]
          ]},
          {"type": "tip", "title": "le bureau", "cs": "*Le bureau* je psací stůl i kancelář."}
        ]},
        {"title": "Slovíčka", "blocks": [{"type": "vocab"}]}
      ],
