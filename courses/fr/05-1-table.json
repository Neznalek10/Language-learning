            ["k pití", "comme boisson"],
            ["Účet, prosím.", "L'addition, s'il vous plaît."]
          ]},
          {"type": "examples", "items": [
            {"fr": "Bonjour, vous avez choisi ?", "cs": "Dobrý den, máte vybráno?"},
            {"fr": "Oui, je voudrais un croque-monsieur, s'il vous plaît.", "cs": "Ano, chtěl bych croque-monsieur, prosím."},
            {"fr": "Et comme boisson ?", "cs": "A k pití?"},
            {"fr": "Un jus d'orange, s'il vous plaît.", "cs": "Pomerančový džus, prosím."}
          ]},
          {"type": "tip", "title": "La carte", "cs": "Jídelní lístek je *la carte*. *Le menu* je ve Francii hlavně menu za pevnou cenu (předkrm, hlavní chod, dezert)."},
          {"type": "check", "item": {"type": "build", "cs": "Chtěl bych polévku, prosím.", "a": ["Je voudrais {une soupe|de la soupe}, s'il vous plaît."]}}
        ]},
