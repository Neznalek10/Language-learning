        {"id": "fr-7-4-03", "type": "cloze", "fr": "___ la deuxième rue à gauche.", "a": ["Prenez"], "hint": "prendre, vous"},
        {"id": "fr-7-4-04", "type": "cloze", "fr": "___ jusqu'à la place.", "a": ["Continuez"], "hint": "continuer, vous"},
