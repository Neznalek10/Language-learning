    {
      "id": "fr-7-3",
      "title": "En bus ou à pied ?",
      "subtitle": "Doprava",
      "topics": ["city"],
      "words": ["transport#autobus", "transport#metro", "transport#tramvaj", "transport#vlak", "transport#auto", "transport#letadlo", "transport#loď", "transport#motorka", "transport#pěšky", "transport#na kole", "transport#autem", "transport#autobusem", "sports#kolo", "geography#zastávka"],
      "learn": [
        {"title": "Čím jedeš?", "blocks": [
          {"type": "text", "cs": "Dopravní prostředek, do kterého nastupuješ, vyjádříš předložkou *en*: *en bus, en métro, en train, en voiture, en avion*. Když jdeš pěšky nebo na něčem sedíš, je *à*: *à pied, à vélo, à moto*."},
          {"type": "table", "firstCs": true, "rows": [
            ["autobusem", "en bus"], ["metrem", "en métro"], ["tramvají", "en tram"], ["vlakem", "en train"], ["autem", "en voiture"],
            ["letadlem", "en avion"], ["lodí", "en bateau"], ["pěšky", "à pied"], ["na kole", "à vélo"], ["na motorce", "à moto"]
          ]},
          {"type": "tip", "title": "prendre", "cs": "Můžeš říct i *prendre* + člen: *Je prends le bus. Il prend le métro.*"},
          {"type": "check", "item": {"type": "cloze", "fr": "Je vais au collège ___ pied.", "a": ["à"]}}
        ]},
        {"title": "Cesta do školy", "blocks": [
          {"type": "examples", "items": [
            {"fr": "Comment tu vas au collège ? En bus.", "cs": "Jak jezdíš do školy? Autobusem."},
            {"fr": "Mon père va au travail en voiture.", "cs": "Můj táta jezdí do práce autem."},
            {"fr": "Je prends le tram à l'arrêt devant la maison.", "cs": "Na tramvaj chodím na zastávku před domem."}
          ]}
        ]},
        {"title": "Slovíčka", "blocks": [{"type": "vocab"}]}
      ],
