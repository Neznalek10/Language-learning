        {"id": "fr-7-4-08", "type": "build", "cs": "Zahněte druhou ulicí doleva.", "a": ["Prenez la deuxième rue à gauche.", "Tournez dans la deuxième rue à gauche."]},
        {"id": "fr-7-4-09", "type": "build", "cs": "Pojďme do parku!", "a": ["Allons au parc !"]},
        {"id": "fr-7-4-10", "type": "build", "cs": "Nepřecházej ulici!", "a": ["Ne traverse pas la rue !"]},
        {"id": "fr-7-4-11", "type": "transform", "task_cs": "Převeď do rozkazovacího způsobu (vous)", "fr": "Vous tournez à gauche.", "a": ["Tournez à gauche !"]},
        {"id": "fr-7-4-12", "type": "transform", "task_cs": "Převeď do rozkazovacího způsobu (tu)", "fr": "Tu vas tout droit.", "a": ["Va tout droit !"], "why": "U aller (a sloves na -er) odpadá v osobě tu koncové -s."},
        {"id": "fr-7-4-13", "type": "order", "cs": "Pokračujte rovně až k náměstí.", "a": ["Continuez tout droit jusqu'à la place"], "extra": ["continue", "au"]}
