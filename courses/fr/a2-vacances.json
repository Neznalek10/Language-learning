                  "odjela",
                  "elle est partie"
                ],
                [
                  "odjeli",
                  "ils sont partis"
                ],
                [
                  "odjely",
                  "elles sont parties"
                ]
              ]
            },
            {
              "type": "text",
              "cs": "Když holka mluví o sobě, píše *je suis allée*. Smíšená skupina kluků a holek má mužský rod: *Paul et Léa sont partis.*"
            },
            {
              "type": "check",
