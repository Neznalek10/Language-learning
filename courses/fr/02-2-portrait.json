      "topics": ["adjectives"],
      "words": ["colors#barva", "colors#modrá", "colors#zelená", "colors#černá", "colors#šedivá", "colors#bílá", "colors#fialová", "colors#červená", "colors#žlutá", "colors#růžová", "colors#hnědá", "colors#oranžová", "colors#béžová", "colors#světlý", "colors#tmavý"],
      "learn": [
        {"title": "Barvy", "blocks": [
          {"type": "table", "head": ["", "mužský rod", "ženský rod"], "firstCs": true, "rows": [
