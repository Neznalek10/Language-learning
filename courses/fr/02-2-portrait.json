          {"type": "check", "item": {"type": "cloze", "fr": "Ma grand-mère est très ___.", "a": ["gentille"], "hint": "hodná"}}
        ]},
        {"title": "Slovíčka", "blocks": [{"type": "vocab"}]}
      ],
