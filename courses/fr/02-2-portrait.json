        {"id": "fr-2.2-2-10", "type": "transform", "task_cs": "Převeď do ženského rodu", "fr": "Il est sérieux.", "a": ["Elle est sérieuse."]},
        {"id": "fr-2.2-2-11", "type": "transform", "task_cs": "Převeď do ženského rodu", "fr": "Il est gentil.", "a": ["Elle est gentille."]},
