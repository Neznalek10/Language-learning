          {"type": "tip", "title": "V mluvené řeči", "cs": "Hovorově se *ne* často vynechává: *Je suis pas timide.* Ve škole a v testech ho ale piš vždy."},
          {"type": "check", "item": {"type": "transform", "task_cs": "Převeď do záporu", "fr": "J'ai une sœur.", "a": ["Je n'ai pas de sœur."]}}
