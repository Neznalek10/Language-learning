{
  "schema": 1,
  "goals": [
    "Popsat vzhled a povahu člověka",
    "Shodovat přídavná jména v rodě a čísle, i nepravidelná",
    "Používat barvy a popsat vlasy a oči",
    "Vědět, kdy přídavné jméno stojí před podstatným jménem",
    "Tvořit zápor ne... pas a pas de"
  ],
  "lessons": [
    {
      "id": "fr-2.2-1",
      "title": "Il est grand",
      "subtitle": "Shoda přídavných jmen",
      "topics": ["adjectives", "describe"],
      "words": ["appearance#velký", "appearance#malý", "appearance#štíhlý", "appearance#mladý", "appearance#hezký", "appearance#průměrný", "personality#sympatický", "personality#stydlivý", "personality#zábavný", "personality#příjemný", "personality#chytrý", "personality#smutný", "personality#klidný", "personality#vtipný"],
      "learn": [
        {"title": "Přídavné jméno se shoduje", "blocks": [
          {"type": "text", "cs": "Přídavné jméno se ve francouzštině řídí rodem a číslem podstatného jména, ke kterému patří. Pro ženský rod přidáš *-e*, pro množné číslo *-s*."},
          {"type": "table", "head": ["", "mužský rod", "ženský rod"], "firstCs": true, "rows": [
            ["jednotné číslo", "il est grand", "elle est grande"],
            ["množné číslo", "ils sont grands", "elles sont grandes"]
          ]},
          {"type": "text", "cs": "Koncové *-e* a *-s* se nevyslovují. V ženském rodě ale uslyšíš souhlásku před *-e*: *petit* [pəti] → *petite* [pətit]."},
          {"type": "tip", "title": "Končí na -e", "cs": "Přídavná jména, která už končí na *-e*, se v ženském rodě nemění: *jeune, mince, timide, sympathique, calme, drôle, triste, agréable*."},
          {"type": "check", "item": {"type": "cloze", "fr": "Marie est ___.", "a": ["petite"], "hint": "malá"}}
        ]},
        {"title": "Ils, nebo elles?", "blocks": [
          {"type": "text", "cs": "Když popisuješ skupinu mužů i žen, použiješ mužský rod množného čísla: *Paul et Marie sont grands.*"},
          {"type": "examples", "items": [
            {"fr": "Mon frère est grand et mince.", "cs": "Můj bratr je vysoký a štíhlý."},
            {"fr": "Ma sœur est petite et sympathique.", "cs": "Moje sestra je malá a sympatická."},
            {"fr": "Mes cousines sont amusantes.", "cs": "Moje sestřenice jsou zábavné."},
            {"fr": "Tom et Léa sont intelligents.", "cs": "Tom a Léa jsou chytří."}
          ]},
          {"type": "check", "item": {"type": "cloze", "fr": "Paul et Léa sont ___.", "a": ["intelligents"], "hint": "chytří"}}
        ]},
        {"title": "Slovíčka", "blocks": [{"type": "vocab"}]}
      ],
      "practice": [
        {"id": "fr-2.2-1-01", "type": "cloze", "fr": "Ma mère est ___.", "a": ["mince"], "hint": "štíhlá", "why": "Mince končí na -e, takže se v ženském rodě nemění."},
        {"id": "fr-2.2-1-02", "type": "cloze", "fr": "Ma sœur est ___.", "a": ["grande"], "hint": "velká"},
        {"id": "fr-2.2-1-03", "type": "cloze", "fr": "Léa est ___.", "a": ["intelligente"], "hint": "chytrá"},
        {"id": "fr-2.2-1-04", "type": "cloze", "fr": "Mes cousins sont ___.", "a": ["amusants"], "hint": "zábavní"},
        {"id": "fr-2.2-1-05", "type": "cloze", "fr": "Mes tantes sont ___.", "a": ["agréables"], "hint": "příjemné"},
        {"id": "fr-2.2-1-06", "type": "cloze", "fr": "Julie est ___.", "a": ["timide"], "hint": "stydlivá"},
        {"id": "fr-2.2-1-07", "type": "cloze", "fr": "Elles sont ___.", "a": ["jeunes"], "hint": "mladé"},
        {"id": "fr-2.2-1-08", "type": "transform", "task_cs": "Převeď do ženského rodu", "fr": "Il est petit.", "a": ["Elle est petite."]},
        {"id": "fr-2.2-1-09", "type": "transform", "task_cs": "Převeď do ženského rodu", "fr": "Il est intelligent.", "a": ["Elle est intelligente."]},
        {"id": "fr-2.2-1-10", "type": "transform", "task_cs": "Převeď do ženského rodu", "fr": "Il est timide.", "a": ["Elle est timide."]},
        {"id": "fr-2.2-1-11", "type": "transform", "task_cs": "Převeď do množného čísla", "fr": "Elle est grande.", "a": ["Elles sont grandes."]},
        {"id": "fr-2.2-1-12", "type": "build", "cs": "Moje sestra je malá a štíhlá.", "a": ["Ma sœur est petite et mince."]},
        {"id": "fr-2.2-1-13", "type": "build", "cs": "Můj bratr je velký a vtipný.", "a": ["Mon frère est grand et drôle."]},
        {"id": "fr-2.2-1-14", "type": "build", "cs": "Paul a Marie jsou mladí.", "a": ["Paul et Marie sont jeunes."]},
        {"id": "fr-2.2-1-15", "type": "order", "cs": "Moje kamarádka je chytrá a zábavná.", "a": ["Mon amie est intelligente et amusante", "Ma copine est intelligente et amusante"], "extra": ["intelligent", "ma"]}
      ]
    },
    {
