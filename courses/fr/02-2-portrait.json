    {
      "id": "fr-2.2-4",
      "title": "Les yeux bleus",
      "subtitle": "Vlasy, oči a pořadí slov",
      "topics": ["adjectives", "describe"],
      "words": ["body#vlasy", "body#oči", "body#oko", "body#obličej", "appearance#světlé vlasy", "appearance#tmavé vlasy", "appearance#zrzavé vlasy", "appearance#kaštanové vlasy", "appearance#krátké", "appearance#dlouhé", "appearance#rovné", "appearance#vlnité", "appearance#kudrnaté"],
      "learn": [
        {"title": "Vlasy a oči", "blocks": [
          {"type": "text", "cs": "Vzhled popíšeš slovesem *avoir* a určitým členem: *J'ai les cheveux blonds.* (Mám blond vlasy.) *Il a les yeux bleus.* (Má modré oči.) *Cheveux* i *yeux* jsou mužského rodu v množném čísle, proto *blonds, bleus*."},
          {"type": "table", "firstCs": true, "rows": [
            ["blond vlasy", "les cheveux blonds"],
            ["tmavé vlasy", "les cheveux bruns"],
            ["zrzavé vlasy", "les cheveux roux"],
            ["kaštanové vlasy", "les cheveux châtains"],
            ["krátké / dlouhé vlasy", "les cheveux courts / longs"],
            ["rovné / vlnité / kudrnaté", "raides / ondulés / frisés"],
            ["modré / zelené / hnědé oči", "les yeux bleus / verts / marron"]
          ]},
          {"type": "tip", "title": "un œil, des yeux", "cs": "Jedno oko je *un œil*, oči jsou *des yeux*. Úplně jiné slovo!"},
          {"type": "check", "item": {"type": "build", "cs": "Mám hnědé oči.", "a": ["J'ai les yeux marron."]}}
        ]},
        {"title": "Před, nebo za?", "blocks": [
          {"type": "text", "cs": "Většina přídavných jmen stojí **za** podstatným jménem: *un garçon timide, une fille sportive*. Několik krátkých a častých stojí **před** ním: *grand, petit, jeune, vieux, beau, joli, nouveau, bon, mauvais*. Například *une petite sœur, un grand frère, une jolie maison*."},
          {"type": "tip", "title": "bel, nouvel, vieil", "cs": "Před samohláskou mají *beau, nouveau, vieux* zvláštní tvar: *un bel homme, un nouvel ami, un vieil oncle*."},
          {"type": "examples", "items": [
            {"fr": "J'ai un grand frère et une petite sœur.", "cs": "Mám staršího bratra a mladší sestru."},
            {"fr": "C'est une fille très sympathique.", "cs": "Je to velmi sympatická holka."},
            {"fr": "Mon père a les cheveux courts et les yeux verts.", "cs": "Můj táta má krátké vlasy a zelené oči."}
          ]},
          {"type": "check", "item": {"type": "cloze", "fr": "J'ai une ___ sœur.", "a": ["petite"], "hint": "malá"}}
        ]},
        {"title": "Slovíčka", "blocks": [{"type": "vocab"}]}
      ],
      "practice": [
        {"id": "fr-2.2-4-01", "type": "cloze", "fr": "Elle a les cheveux ___.", "a": ["blonds"], "hint": "blond"},
        {"id": "fr-2.2-4-02", "type": "cloze", "fr": "Il a les yeux ___.", "a": ["verts"], "hint": "zelené"},
        {"id": "fr-2.2-4-03", "type": "cloze", "fr": "Mon père a les cheveux ___.", "a": ["courts"], "hint": "krátké"},
        {"id": "fr-2.2-4-04", "type": "cloze", "fr": "Ma sœur a les cheveux ___.", "a": ["longs"], "hint": "dlouhé"},
        {"id": "fr-2.2-4-05", "type": "cloze", "fr": "Léa a les cheveux ___.", "a": ["roux"], "hint": "zrzavé"},
        {"id": "fr-2.2-4-06", "type": "cloze", "fr": "J'ai un ___ ami.", "a": ["nouvel"], "hint": "nový", "why": "Před samohláskou se nouveau mění na nouvel."},
        {"id": "fr-2.2-4-07", "type": "build", "cs": "Mám blond vlasy a modré oči.", "a": ["J'ai les cheveux blonds et les yeux bleus."]},
        {"id": "fr-2.2-4-08", "type": "build", "cs": "Má krátké tmavé vlasy.", "a": ["{Il|Elle} a les cheveux {courts et bruns|bruns et courts}."]},
        {"id": "fr-2.2-4-09", "type": "build", "cs": "Mám mladší sestru a staršího bratra.", "a": ["J'ai une petite sœur et un grand frère."]},
        {"id": "fr-2.2-4-10", "type": "build", "cs": "Je to sympatický kluk.", "a": ["C'est un garçon sympathique."]},
        {"id": "fr-2.2-4-11", "type": "build", "cs": "Moje babička má kudrnaté vlasy.", "a": ["Ma grand-mère a les cheveux frisés."]},
        {"id": "fr-2.2-4-12", "type": "transform", "task_cs": "Popiš dívku (ženský rod)", "fr": "C'est un petit garçon blond.", "a": ["C'est une petite fille blonde."]},
        {"id": "fr-2.2-4-13", "type": "order", "cs": "Můj kamarád má hnědé oči.", "a": ["Mon copain a les yeux marron", "Mon ami a les yeux marron"], "extra": ["marrons", "est"]}
      ]
    },
    {
      "id": "fr-2.2-5",
      "title": "Je ne suis pas timide",
      "subtitle": "Zápor ne... pas",
      "topics": ["negation"],
      "words": ["basics#ne", "basics#vůbec ne", "appearance#ošklivý", "personality#nesympatický", "personality#optimista", "personality#pesimista", "personality#spokojený", "personality#blázen"],
      "learn": [
        {"title": "Zápor ne... pas", "blocks": [
          {"type": "text", "cs": "Zápor má ve francouzštině dvě části, které obklopí sloveso: *ne* + sloveso + *pas*. *Je suis timide. → Je ne suis pas timide.* Před samohláskou se *ne* zkracuje na *n'*: *Il n'est pas grand.*"},
          {"type": "examples", "items": [
            {"fr": "Je ne suis pas français.", "cs": "Nejsem Francouz."},
            {"fr": "Elle n'est pas sportive.", "cs": "Není sportovní."},
            {"fr": "Nous ne sommes pas frères.", "cs": "Nejsme bratři."},
            {"fr": "Il n'est pas du tout timide.", "cs": "Není vůbec stydlivý."}
          ]},
          {"type": "tip", "title": "Zvratná slovesa", "cs": "U zvratných sloves stojí *ne* před zájmenem: *Je ne m'appelle pas Paul.*"},
          {"type": "check", "item": {"type": "transform", "task_cs": "Převeď do záporu", "fr": "Je suis grand.", "a": ["Je ne suis pas grand."]}}
        ]},
        {"title": "pas de", "blocks": [
          {"type": "text", "cs": "Po záporu se *un, une, des* mění na *de* (před samohláskou *d'*): *J'ai un frère. → Je n'ai pas de frère.* *J'ai un animal. → Je n'ai pas d'animal.*"},
