          "blocks": [
            {
              "type": "text",
              "cs": "*Le temps d'écran* = čas strávený u obrazovky. *Je passe deux heures par jour sur mon portable.* (Trávím dvě hodiny denně na mobilu.) Na internetu = *sur Internet*, na sociálních sítích = *sur les réseaux sociaux*."
            },
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Je regarde des vidéos sur mon portable.",
                  "cs": "Dívám se na videa v mobilu."
                },
                {
                  "fr": "Il joue sur son ordinateur tous les soirs.",
                  "cs": "Každý večer hraje na počítači."
                },
                {
                  "fr": "Tu es sur quels réseaux sociaux ?",
                  "cs": "Na jakých sociálních sítích jsi?"
                },
                {
                  "fr": "Mon portable n'a plus de batterie.",
                  "cs": "Mobil mi došel."
                }
