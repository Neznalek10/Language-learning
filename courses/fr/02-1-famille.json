    {
      "id": "fr-2.1-4",
      "title": "Mes animaux",
      "subtitle": "Zvířata a zvláštní množné číslo",
      "topics": ["family", "articles"],
      "words": ["animals#zvíře", "animals#zvířata", "animals#pes", "animals#kočka", "animals#pták", "animals#papoušek", "animals#křeček", "animals#morče", "animals#rybička", "animals#želva", "animals#králík", "animals#kůň", "animals#koně", "animals#myš", "animals#had"],
      "learn": [
        {"title": "Máš nějaké zvíře?", "blocks": [
          {"type": "text", "cs": "Na otázku *Tu as un animal ?* (Máš nějaké zvíře?) odpovíš třeba *J'ai un chien.* Zvíře je pak *il*, nebo *elle* podle rodu slova: *le chat → il*, *la tortue → elle*."},
          {"type": "examples", "items": [
            {"fr": "J'ai un chat. Il s'appelle Félix.", "cs": "Mám kočku. Jmenuje se Félix."},
            {"fr": "Ma sœur a une tortue. Elle a cinq ans.", "cs": "Moje sestra má želvu. Je jí pět let."},
            {"fr": "Nous avons deux lapins.", "cs": "Máme dva králíky."}
          ]},
          {"type": "check", "item": {"type": "cloze", "fr": "J'ai une tortue. ___ s'appelle Lili.", "a": ["Elle"]}}
        ]},
        {"title": "Zvláštní množné číslo", "blocks": [
          {"type": "text", "cs": "Slova na *-al* mají v množném čísle *-aux*: *un animal → des animaux, un cheval → des chevaux*. Slova na *-eau* dostávají *-x*: *un oiseau → des oiseaux*. Slova, která už končí na *-s* nebo *-x*, se nemění: *une souris → des souris*."},
          {"type": "table", "head": ["jednotné číslo", "množné číslo"], "rows": [
            ["un animal", "des animaux"], ["un cheval", "des chevaux"], ["un oiseau", "des oiseaux"], ["une souris", "des souris"]
          ]},
          {"type": "check", "item": {"type": "transform", "task_cs": "Převeď do množného čísla", "fr": "un cheval", "a": ["des chevaux"]}}
        ]},
        {"title": "Slovíčka", "blocks": [{"type": "vocab"}]}
      ],
