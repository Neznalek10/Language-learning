      "learn": [
        {"title": "Náš, váš, jejich", "blocks": [
          {"type": "table", "head": ["", "jednotné číslo", "množné číslo"], "firstCs": true, "rows": [
            ["náš / naše", "notre père, notre mère", "nos parents"],
            ["váš / vaše", "votre frère, votre sœur", "vos cousins"],
            ["jejich", "leur oncle, leur tante", "leurs enfants"]
          ]},
          {"type": "text", "cs": "Tady se mužský a ženský rod neliší, mění se jen číslo: *notre/nos, votre/vos, leur/leurs*."},
          {"type": "tip", "title": "leur, nebo leurs?", "cs": "*Leur* má *-s* jen v množném čísle: *leur fils* (jejich syn), *leurs enfants* (jejich děti)."},
          {"type": "check", "item": {"type": "cloze", "fr": "___ parents sont à Paris.", "a": ["Nos"], "hint": "naši"}}
        ]},
        {"title": "Petrův, Mariin", "blocks": [
          {"type": "text", "cs": "Tvary jako „Petrův“ nebo „Mariin“ francouzština nemá. Vlastnictví vyjádříš pomocí *de*: *le frère de Petr* (Petrův bratr), *la mère de Marie* (Mariina matka). Před samohláskou *d'*: *le chien d'Anna*."},
          {"type": "examples", "items": [
