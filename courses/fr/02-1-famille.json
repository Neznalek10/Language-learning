      "learn": [
        {"title": "70 až 79", "blocks": [
          {"type": "text", "cs": "Francouzština nemá zvláštní slovo pro 70. Říká „šedesát deset“: *soixante-dix*. Pak pokračuje *soixante et onze* (71), *soixante-douze* (72) až *soixante-dix-neuf* (79)."},
          {"type": "table", "firstCs": true, "rows": [["70", "soixante-dix"], ["71", "soixante et onze"], ["72", "soixante-douze"], ["75", "soixante-quinze"], ["79", "soixante-dix-neuf"]]},
          {"type": "check", "item": {"type": "cloze", "fr": "soixante-dix, soixante et onze, ___", "a": ["soixante-douze"]}}
