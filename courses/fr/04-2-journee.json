    {
      "id": "fr-4.2-1",
      "title": "Je me lève",
      "subtitle": "Zvratná slovesa",
      "topics": ["reflexive", "daily"],
      "words": ["verbs-reflexive#probudit se", "verbs-reflexive#vstát", "verbs-reflexive#mýt se", "verbs-reflexive#čistit kartáčem", "verbs-reflexive#sprchovat se", "verbs-reflexive#obléknout se", "verbs-reflexive#česat se", "verbs-reflexive#lehnout si", "verbs-reflexive#odpočívat"],
      "learn": [
        {"title": "Zvratná slovesa", "blocks": [
          {"type": "text", "cs": "Zvratná slovesa mají navíc zájmeno, které se mění podle osoby: *me, te, se, nous, vous, se*. Před samohláskou se *me, te, se* zkracují na *m', t', s'*."},
          {"type": "table", "verb": "se laver", "tense": "present"},
          {"type": "tip", "title": "Česky jinak", "cs": "Ne každé české zvratné sloveso je zvratné i ve francouzštině a naopak: *se lever* znamená vstávat, česky bez „se“."},
          {"type": "check", "item": {"type": "cloze", "fr": "Je ___ lave.", "a": ["me"]}}
        ]},
        {"title": "Se lever", "blocks": [
          {"type": "text", "cs": "*Se lever* mění v kořeni *e* na *è*, když je koncovka nevyslovená: *je me lève*, ale *nous nous levons*."},
          {"type": "table", "verb": "se lever", "tense": "present"},
          {"type": "examples", "items": [
            {"fr": "Je me réveille à six heures et demie.", "cs": "Probouzím se v půl sedmé."},
            {"fr": "Je me douche et je m'habille.", "cs": "Osprchuju se a obleču se."},
            {"fr": "Mon frère se lève à sept heures.", "cs": "Můj bratr vstává v sedm."},
            {"fr": "Nous nous couchons à dix heures.", "cs": "Chodíme spát v deset."}
          ]},
          {"type": "check", "item": {"type": "cloze", "fr": "Tu te ___ à quelle heure ?", "a": ["lèves"], "hint": "se lever"}}
        ]},
        {"title": "Slovíčka", "blocks": [{"type": "vocab"}]}
      ],
      "practice": [
        {"id": "fr-4.2-1-f", "type": "form", "verb": "se lever", "tense": "present"},
        {"id": "fr-4.2-1-01", "type": "cloze", "fr": "Je ___ réveille à six heures.", "a": ["me"]},
        {"id": "fr-4.2-1-02", "type": "cloze", "fr": "Tu ___ douches le matin ?", "a": ["te"]},
        {"id": "fr-4.2-1-03", "type": "cloze", "fr": "Il ___habille.", "a": ["s'"]},
        {"id": "fr-4.2-1-04", "type": "cloze", "fr": "Nous ___ couchons tard.", "a": ["nous"]},
