        {"id": "fr-4.2-1-06", "type": "cloze", "fr": "Ils se ___ les dents.", "a": ["brossent"], "hint": "se brosser"},
        {"id": "fr-4.2-1-07", "type": "build", "cs": "Vstávám v sedm.", "a": ["Je me lève à sept heures."]},
        {"id": "fr-4.2-1-08", "type": "build", "cs": "Sprchuju se a oblékám se.", "a": ["Je me douche et je m'habille."]},
        {"id": "fr-4.2-1-09", "type": "build", "cs": "V kolik hodin si lehneš?", "a": ["{À quelle heure est-ce que tu te couches|Tu te couches à quelle heure|À quelle heure te couches-tu} ?"]},
        {"id": "fr-4.2-1-10", "type": "build", "cs": "Můj bratr se probouzí pozdě.", "a": ["Mon frère se réveille tard."]},
        {"id": "fr-4.2-1-11", "type": "transform", "task_cs": "Změň osobu na nous", "fr": "Je me lave.", "a": ["{Nous nous lavons|On se lave}."]},
        {"id": "fr-4.2-1-12", "type": "transform", "task_cs": "Změň osobu na elle", "fr": "Je m'habille.", "a": ["Elle s'habille."]},
        {"id": "fr-4.2-1-13", "type": "order", "cs": "Čistím si zuby.", "a": ["Je me brosse les dents"], "extra": ["te", "mes"]}
      ]
    },
    {
      "id": "fr-4.2-2",
      "title": "Je ne me lève pas tôt",
      "subtitle": "Zápor a otázky se zvratnými slovesy",
      "topics": ["reflexive", "negation"],
      "words": ["time#brzy", "time#pozdě", "time#ráno", "time#večer", "time#obvykle", "time#každý den", "verbs-reflexive#holit se", "verbs-reflexive#malovat se"],
      "learn": [
        {"title": "Zápor", "blocks": [
          {"type": "text", "cs": "*Ne* stojí před zvratným zájmenem, *pas* za slovesem: *Je ne me lève pas tôt. Il ne se couche pas tard.* Před samohláskou je *n'*: *Elle ne s'habille pas.*"},
          {"type": "examples", "items": [
            {"fr": "Je ne me lève pas tôt le dimanche.", "cs": "V neděli nevstávám brzy."},
            {"fr": "Mon père ne se rase pas.", "cs": "Můj táta se neholí."},
            {"fr": "Tu ne te couches pas ?", "cs": "Nejdeš spát?"}
          ]},
          {"type": "check", "item": {"type": "transform", "task_cs": "Převeď do záporu", "fr": "Je me réveille tôt.", "a": ["Je ne me réveille pas tôt."]}}
        ]},
        {"title": "Otázky", "blocks": [
          {"type": "text", "cs": "Ptát se můžeš všemi třemi způsoby: *Tu te lèves à quelle heure ?* / *À quelle heure est-ce que tu te lèves ?* V inverzi zůstává zájmeno před slovesem: *À quelle heure te lèves-tu ?*"}
        ]},
        {"title": "Brzy a pozdě", "blocks": [
          {"type": "table", "firstCs": true, "rows": [
            ["brzy", "tôt"], ["pozdě", "tard"], ["ráno", "le matin"], ["večer", "le soir"],
            ["obvykle", "d'habitude"], ["každý den", "tous les jours"], ["v týdnu", "en semaine"], ["o víkendu", "le week-end"]
          ]}
        ]},
        {"title": "Slovíčka", "blocks": [{"type": "vocab"}]}
      ],
      "practice": [
        {"id": "fr-4.2-2-01", "type": "transform", "task_cs": "Převeď do záporu", "fr": "Je me lève tôt.", "a": ["Je ne me lève pas tôt."]},
        {"id": "fr-4.2-2-02", "type": "transform", "task_cs": "Převeď do záporu", "fr": "Il se douche le soir.", "a": ["Il ne se douche pas le soir."]},
        {"id": "fr-4.2-2-03", "type": "transform", "task_cs": "Převeď do záporu", "fr": "Nous nous couchons tard.", "a": ["{Nous ne nous couchons pas|On ne se couche pas} tard."]},
        {"id": "fr-4.2-2-04", "type": "transform", "task_cs": "Převeď do záporu", "fr": "Elle se maquille.", "a": ["Elle ne se maquille pas."]},
        {"id": "fr-4.2-2-05", "type": "cloze", "fr": "Je ne ___ lève pas tôt.", "a": ["me"]},
        {"id": "fr-4.2-2-06", "type": "cloze", "fr": "Il ne se rase ___.", "a": ["pas"]},
        {"id": "fr-4.2-2-07", "type": "build", "cs": "Obvykle vstávám brzy.", "a": ["D'habitude, je me lève tôt."]},
        {"id": "fr-4.2-2-08", "type": "build", "cs": "O víkendu vstávám pozdě.", "a": ["Le week-end, je me lève tard."]},
        {"id": "fr-4.2-2-09", "type": "build", "cs": "Ráno se nesprchuju.", "a": ["Je ne me douche pas le matin.", "Le matin, je ne me douche pas."]},
        {"id": "fr-4.2-2-10", "type": "build", "cs": "V kolik hodin vstáváš?", "a": ["{À quelle heure est-ce que tu te lèves|Tu te lèves à quelle heure|À quelle heure te lèves-tu} ?"]},
        {"id": "fr-4.2-2-11", "type": "build", "cs": "V týdnu chodím spát v deset.", "a": ["En semaine, je me couche à dix heures."]},
        {"id": "fr-4.2-2-12", "type": "order", "cs": "Můj táta se neholí.", "a": ["Mon père ne se rase pas", "Mon papa ne se rase pas"], "extra": ["me", "rasé"]}
      ]
    },
