        {"id": "fr-1.2-4-13", "type": "build", "cs": "Jsem z Německa, ale bydlím ve Francii.", "a": ["Je viens d'Allemagne, mais j'habite en France."]},
        {"id": "fr-1.2-4-14", "type": "order", "cs": "V Kanadě se mluví francouzsky.", "a": ["Au Canada on parle français"], "extra": ["en", "parlons"]},
