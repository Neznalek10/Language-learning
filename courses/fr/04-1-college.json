        {"id": "fr-4.1-5-03", "type": "cloze", "fr": "Les cours ___ à huit heures.", "a": ["commencent"], "hint": "commencer"},
        {"id": "fr-4.1-5-04", "type": "cloze", "fr": "Nous ___ à neuf heures.", "a": ["commençons"], "hint": "commencer"},
        {"id": "fr-4.1-5-05", "type": "cloze", "fr": "Elles ___ à midi.", "a": ["finissent"], "hint": "finir"},
        {"id": "fr-4.1-5-06", "type": "cloze", "fr": "Vous ___ quand ?", "a": ["finissez"], "hint": "finir"},
        {"id": "fr-4.1-5-07", "type": "build", "cs": "Vyučování končí ve tři.", "a": ["Les cours {finissent|se terminent} à trois heures."]},
        {"id": "fr-4.1-5-08", "type": "build", "cs": "Mám tužku a sešit.", "a": ["J'ai un crayon et un cahier."]},
        {"id": "fr-4.1-5-09", "type": "build", "cs": "Máš pero?", "a": ["{Tu as|As-tu|Est-ce que tu as} un stylo ?"]},
        {"id": "fr-4.1-5-10", "type": "build", "cs": "Dělám domácí úkoly.", "a": ["Je fais mes devoirs."]},
