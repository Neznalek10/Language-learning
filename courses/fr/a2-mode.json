      "learn": [
        {
          "title": "ten, ta, to, ty",
          "blocks": [
            {
              "type": "text",
              "cs": "Když na něco ukazuješ (*tenhle svetr, tahle sukně*), použiješ *ce, cet, cette, ces*."
            },
            {
              "type": "table",
              "firstCs": true,
              "rows": [
                [
                  "tento svetr",
                  "ce pull"
                ],
                [
                  "tento kamarád",
                  "cet ami"
                ],
                [
                  "tato sukně",
                  "cette jupe"
                ],
                [
                  "tyto boty",
                  "ces chaussures"
                ]
              ]
            },
            {
              "type": "text",
              "cs": "*Cet* stojí před mužským slovem, které začíná samohláskou nebo němým *h*: *cet ami, cet hôtel, cet été*. *Ces* je množné číslo pro oba rody."
            },
            {
              "type": "check",
              "item": {
                "type": "cloze",
                "fr": "Tu aimes ___ robe ?",
                "a": [
