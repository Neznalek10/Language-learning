    {
      "id": "im-03-negative",
      "title": "Step 3: Negative commands: Ne fais pas ça !",
      "fr": "l'impératif négatif",
      "level": "A1",
      "keywords": [
        "step by step",
        "imperative",
        "negative command",
        "ne pas",
        "don't",
        "ne fais pas",
        "ne dis rien"
      ],
      "topics": [],
      "see": [
        "imperative",
        "ne-pas"
      ],
      "sections": [
        {
          "title": "In short",
          "blocks": [
            {
              "type": "text",
              "en": "Put **ne** before the verb and **pas** after it, as in any negative: *Ne parle pas ! N'oublie pas !* The other negative words work too: *Ne dis rien ! Ne fais jamais ça !*"
            },
            {
              "type": "pattern",
              "rows": [
                {
                  "parts": [
                    [
                      "neg",
                      "Ne"
                    ],
                    [
                      "V",
                      "parle"
                    ],
                    [
                      "neg",
                      "pas !"
                    ]
                  ],
                  "en": "Don't speak!"
                },
                {
                  "parts": [
                    [
                      "neg",
                      "N'"
                    ],
                    [
                      "V",
                      "oubliez"
                    ],
                    [
                      "neg",
                      "pas"
                    ],
                    [
                      "obj",
                      "vos livres !"
                    ]
                  ],
                  "en": "Don't forget your books!"
                }
              ],
              "formula": [
                "neg",
                "V",
                "neg"
              ]
            }
          ]
        },
        {
          "title": "Ne ... pas",
          "blocks": [
            {
              "type": "text",
              "en": "*Ne* becomes *n'* before a vowel: *N'ouvre pas ! N'ayez pas peur !* *Un, une, du, des* become **de**: *Faites du bruit → Ne faites pas de bruit !*"
            },
            {
              "type": "check",
              "item": {
                "type": "transform",
                "task_en": "Make the command negative",
                "fr": "Mange !",
                "a": [
                  "Ne mange pas !"
                ]
              }
            }
          ]
        },
        {
          "title": "Other negative words",
          "blocks": [
            {
              "type": "text",
              "en": "*Ne ... jamais* (never), *ne ... plus* (no more), *ne ... rien* (nothing), *ne ... personne* (nobody): *Ne mange plus de bonbons ! Ne dis rien à personne !*"
            },
            {
              "type": "check",
              "item": {
                "type": "build",
                "en": "Don't say anything! (tu)",
                "a": [
                  "Ne dis rien !"
                ]
              }
            }
          ]
        },
        {
          "title": "Watch out",
          "blocks": [
            {
              "type": "tip",
              "en": "Spoken French sometimes drops *ne* (*Fais pas ça !*). In writing keep it."
            },
            {
              "type": "tip",
              "en": "A short sign can be just *pas de* + noun: *Pas de bruit !* (No noise!)"
            }
          ]
        },
        {
          "title": "Examples",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Ne touche pas, c'est chaud !",
                  "en": "Don't touch, it's hot!"
                },
                {
                  "fr": "N'oublie pas ton sac !",
                  "en": "Don't forget your bag!"
                },
                {
                  "fr": "Ne soyez pas en retard demain.",
                  "en": "Don't be late tomorrow."
                },
                {
                  "fr": "Ne parlons plus de ça.",
                  "en": "Let's not talk about that anymore."
                },
                {
                  "fr": "Ne fais jamais ça !",
                  "en": "Never do that!"
                }
              ]
            }
          ]
        }
      ],
      "checks": [
