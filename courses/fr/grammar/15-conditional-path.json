                      "serais"
                    ],
                    [
                      "part",
                      "venu."
                    ]
                  ],
                  "en": "If I had known, I would have come."
                }
              ],
              "formula": [
                [
                  "conj",
                  "si"
                ],
                "S",
                [
                  "aux",
                  "imparfait"
                ],
                "part",
                "S",
                [
                  "aux",
                  "conditionnel"
                ],
                "part"
              ]
            }
          ]
        },
        {
          "title": "The plus-que-parfait",
          "blocks": [
            {
              "type": "text",
              "en": "The **imparfait** of *avoir* or *être* + the past participle: *j'avais fait, tu avais vu, elle était partie, nous étions restés*. Same auxiliary and agreement as in the passé composé."
            },
            {
              "type": "table",
              "verb": "faire",
              "tense": "plus-que-parfait"
            },
            {
              "type": "check",
              "item": {
                "type": "form",
                "verb": "partir",
                "tense": "plus-que-parfait",
                "person": 2
              }
            }
          ]
        },
        {
          "title": "The pattern",
          "blocks": [
            {
              "type": "table",
              "head": [
                "si + plus-que-parfait",
                "conditionnel passé"
              ],
              "rows": [
                [
                  "Si j'avais su,",
                  "je serais venu."
                ],
                [
                  "Si tu avais travaillé,",
                  "tu aurais réussi."
                ],
                [
                  "Si nous étions partis plus tôt,",
                  "nous aurions eu le train."
                ],
                [
                  "S'il n'avait pas plu,",
                  "on serait allés à la plage."
                ]
              ]
            },
            {
              "type": "check",
              "item": {
                "type": "cloze",
                "fr": "Si j'___, je serais venu.",
                "a": [
                  "avais su"
                ],
                "hint": "savoir",
                "en": "If I had known, I would have come."
              }
            }
          ]
        },
        {
          "title": "Past condition, present result",
          "blocks": [
            {
              "type": "text",
              "en": "When the result is **now**, the second half is a plain conditionnel: *Si j'avais pris le bus, je serais à la maison maintenant.* (If I had taken the bus, I'd be at home now.)"
            }
          ]
        },
        {
          "title": "Watch out",
          "blocks": [
            {
              "type": "compare",
              "items": [
                {
                  "en": "If I had known...",
                  "wrong": "Si j'aurais su...",
                  "fr": "Si j'[[avais su]]...",
                  "note": "never the conditional after si, even in the past"
                }
              ]
            },
            {
              "type": "tip",
              "en": "In Czech the same sentence can be about now or about the past. French cannot: choose *si je savais* (if I knew, now) or *si j'avais su* (if I had known, in the past).",
              "title": "Different from Czech"
            }
          ]
        },
        {
          "title": "Examples",
          "blocks": [
            {
