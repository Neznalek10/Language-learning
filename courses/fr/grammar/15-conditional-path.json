    {
      "id": "co-02-uses",
      "title": "Step 2: Using it: polite requests, wishes, advice",
      "fr": "employer le conditionnel",
      "level": "A2",
      "keywords": [
        "step by step",
        "conditional",
        "polite",
        "je voudrais",
        "j'aimerais",
        "tu devrais",
        "pourriez-vous",
        "advice",
        "wishes"
      ],
      "topics": [],
      "see": [
        "conditionnel",
        "modals"
      ],
      "tense": "conditionnel-present",
      "sections": [
        {
          "title": "In short",
          "blocks": [
            {
              "type": "text",
              "en": "The conditional makes things softer and less certain. Three everyday uses: **polite requests** (*Je voudrais un café*), **wishes** (*J'aimerais aller au Japon*) and **advice** (*Tu devrais dormir*)."
            }
          ]
        },
        {
          "title": "Polite requests",
          "blocks": [
            {
              "type": "text",
              "en": "*Je voudrais...* (I'd like), *Pourriez-vous...?* (Could you...?), *Vous auriez l'heure ?* (Would you have the time?), *Ça vous dérangerait de...?* (Would you mind...?)"
            },
            {
              "type": "check",
              "item": {
                "type": "cloze",
                "fr": "___-vous m'aider ?",
                "a": [
                  "Pourriez"
                ],
                "hint": "pouvoir",
                "en": "Could you help me?"
              }
            }
          ]
        },
        {
          "title": "Wishes",
          "blocks": [
            {
              "type": "text",
              "en": "*J'aimerais...* (I'd like to), *Je préférerais...* (I'd rather), *Ce serait génial de...* (It would be great to)."
            },
            {
              "type": "check",
              "item": {
                "type": "cloze",
                "fr": "J'___ visiter Paris.",
                "a": [
                  "aimerais"
                ],
                "hint": "aimer",
                "en": "I'd like to visit Paris."
              }
            }
          ]
        },
        {
          "title": "Advice",
          "blocks": [
            {
              "type": "text",
              "en": "*Tu devrais...* (you should), *Vous pourriez...* (you could), *Il faudrait...* (it would be necessary to), *À ta place, je...* (if I were you, I...)."
            },
            {
              "type": "check",
              "item": {
                "type": "cloze",
                "fr": "Tu ___ te coucher plus tôt.",
                "a": [
                  "devrais"
                ],
                "hint": "devoir",
                "en": "You should go to bed earlier."
              }
            }
          ]
        },
        {
          "title": "Examples",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Je voudrais deux croissants, s'il vous plaît.",
                  "en": "I'd like two croissants, please."
                },
                {
                  "fr": "Pourriez-vous répéter ?",
                  "en": "Could you repeat that?"
                },
                {
                  "fr": "J'aimerais jouer en équipe nationale.",
                  "en": "I'd like to play for the national team."
                },
                {
                  "fr": "Tu devrais t'entraîner plus souvent.",
                  "en": "You should train more often."
                },
                {
                  "fr": "On pourrait aller au match samedi.",
                  "en": "We could go to the match on Saturday."
                }
              ]
            }
          ]
        }
      ],
      "checks": [
