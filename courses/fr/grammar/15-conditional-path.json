                  "il faudrait"
                ]
              ]
            },
            {
              "type": "check",
              "item": {
                "type": "form",
                "verb": "être",
                "tense": "conditionnel-present",
                "person": 3
              }
            }
          ]
        },
        {
          "title": "Watch out",
          "blocks": [
            {
              "type": "tip",
              "en": "Future or conditional? Only the ending differs: *je parlerai* (I will speak) / *je parlerais* (I would speak)."
            },
            {
              "type": "tip",
              "en": "Two *r* in *pourrais, verrais, courrais*, one in *serais, ferais, aurais*."
            }
          ]
        },
        {
          "title": "Examples",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Je voudrais un chocolat chaud.",
                  "en": "I would like a hot chocolate."
                },
                {
                  "fr": "Tu serais content ?",
                  "en": "Would you be happy?"
                },
                {
                  "fr": "Nous irions bien au cinéma.",
                  "en": "We'd happily go to the cinema."
                },
                {
                  "fr": "Ils feraient ça pour toi.",
                  "en": "They would do that for you."
                },
                {
                  "fr": "Vous pourriez m'aider ?",
                  "en": "Could you help me?"
                }
              ]
            }
          ]
        }
      ],
