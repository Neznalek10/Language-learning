      "sections": [
        {
          "title": "In short",
          "blocks": [
            {
              "type": "table",
              "head": [
                "number",
                "French"
              ],
              "textCols": [
                0
              ],
              "rows": [
                [
                  "100",
                  "cent"
                ],
                [
                  "101",
                  "cent un"
                ],
                [
                  "200",
                  "deux cents"
                ],
                [
                  "250",
                  "deux cent cinquante"
                ],
                [
                  "1 000",
                  "mille"
                ],
                [
                  "2 000",
                  "deux mille"
                ],
                [
                  "2026",
                  "deux mille vingt-six"
                ],
                [
