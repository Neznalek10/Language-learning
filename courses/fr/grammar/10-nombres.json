    {
      "id": "numbers-70-100",
      "title": "Numbers 70 to 100",
      "fr": "les nombres de 70 à 100",
      "level": "A1",
      "keywords": [
        "70",
        "80",
        "90",
        "soixante-dix",
        "quatre-vingts",
        "quatre-vingt-dix",
        "septante",
        "nonante",
        "counting in twenties"
      ],
      "topics": [
        "numbers"
      ],
      "see": [
        "numbers-0-69",
        "big-numbers"
      ],
      "sections": [
        {
          "title": "In short",
          "blocks": [
            {
              "type": "text",
              "en": "From 70 French counts in twenties. It looks complicated, but you only need to add."
            },
            {
              "type": "table",
              "head": [
                "number",
                "French",
                "literally"
              ],
              "textCols": [
                0,
                2
              ],
              "rows": [
                [
                  "70",
                  "soixante-dix",
                  "60 + 10"
                ],
                [
                  "71",
                  "soixante et onze",
                  "60 + 11"
                ],
                [
                  "75",
                  "soixante-quinze",
                  "60 + 15"
                ],
                [
                  "80",
                  "quatre-vingts",
                  "4 × 20"
                ],
                [
                  "81",
                  "quatre-vingt-un",
                  "4 × 20 + 1"
                ],
                [
                  "90",
                  "quatre-vingt-dix",
                  "4 × 20 + 10"
                ],
                [
                  "99",
                  "quatre-vingt-dix-neuf",
                  "4 × 20 + 19"
                ],
                [
                  "100",
                  "cent",
                  "100"
                ]
              ]
            }
          ]
        },
        {
          "title": "Spelling",
          "blocks": [
            {
              "type": "text",
              "en": "*Quatre-vingts* takes an *-s* only when nothing follows: *quatre-vingts*, but *quatre-vingt-trois*. With 81 and 91 there is **no** *et* any more."
            },
            {
              "type": "compare",
              "items": [
                {
                  "en": "80",
                  "wrong": "quatre-vingt",
                  "fr": "quatre-vingt[[s]]"
                },
                {
                  "en": "81",
                  "wrong": "quatre-vingt et un",
                  "fr": "quatre-vingt-[[un]]"
                }
              ]
            },
            {
              "type": "tip",
              "title": "Belgium and Switzerland",
              "en": "In Belgium and Switzerland they say *septante* (70) and *nonante* (90), in Switzerland *huitante* (80) too. In France and at school *soixante-dix* and *quatre-vingt-dix* apply."
            }
          ]
        },
        {
          "title": "Examples",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Ma grand-mère a soixante-dix-huit ans.",
                  "en": "My grandmother is seventy-eight."
                },
                {
                  "fr": "Ça coûte quatre-vingts euros.",
                  "en": "It costs eighty euros."
                },
                {
                  "fr": "Il y a quatre-vingt-dix-neuf verbes dans l'appli.",
                  "en": "There are ninety-nine verbs in the app."
                },
                {
                  "fr": "Mon grand-père a quatre-vingt-un ans.",
                  "en": "My grandfather is eighty-one."
                }
              ]
            }
          ]
        }
      ],
