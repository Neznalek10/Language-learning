        "numbers-0-69"
      ],
      "sections": [
        {
          "title": "In short",
          "blocks": [
            {
              "type": "text",
              "en": "You ask *Quelle heure est-il ?* and answer *Il est...* + number + *heure(s)*. The word *heures* is never left out."
            },
            {
              "type": "table",
              "head": [
                "time",
                "French",
                "English"
              ],
              "textCols": [
                0,
                2
              ],
              "rows": [
                [
                  "8:00",
                  "Il est huit heures.",
                  "It's eight o'clock."
                ],
                [
                  "8:15",
                  "Il est huit heures et quart.",
                  "It's a quarter past eight."
                ],
                [
                  "8:30",
                  "Il est huit heures et demie.",
                  "It's half past eight."
                ],
                [
                  "8:45",
                  "Il est neuf heures moins le quart.",
                  "It's a quarter to nine."
                ],
                [
                  "8:50",
                  "Il est neuf heures moins dix.",
                  "It's ten to nine."
                ],
                [
                  "12:00",
                  "Il est midi.",
                  "It's noon."
                ],
                [
                  "0:00",
                  "Il est minuit.",
                  "It's midnight."
                ]
              ]
            }
          ]
        },
        {
          "title": "Watch out for half past",
          "blocks": [
            {
              "type": "compare",
              "items": [
                {
                  "en": "It's half past eight. (8:30)",
                  "wrong": "Il est neuf heures et demie.",
                  "fr": "Il est [[huit]] heures et demie.",
                  "note": "In Czech, half past eight is called \"half nine\" and points to the next hour. French counts from the previous hour: eight and a half."
                }
              ]
            }
          ]
        },
        {
          "title": "24 hours and at what time",
          "blocks": [
            {
              "type": "text",
              "en": "In timetables, on TV and in shops the 24-hour clock is used and read with whole numbers: *Le train part à dix-sept heures quarante.* (17:40)"
            },
            {
              "type": "text",
              "en": "\"At what time\" = *à quelle heure*: *À quelle heure tu te lèves ? À sept heures.*"
            }
          ]
        },
        {
          "title": "Examples",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Il est une heure.",
                  "en": "It's one o'clock."
                },
                {
                  "fr": "On mange à midi et demi.",
                  "en": "We eat at half past twelve."
                },
                {
                  "fr": "Le cours finit à quinze heures trente.",
                  "en": "The lesson ends at 15:30."
                },
                {
                  "fr": "Je me couche vers dix heures.",
                  "en": "I go to bed around ten."
                }
              ]
            }
          ]
        }
      ],
      "checks": [
