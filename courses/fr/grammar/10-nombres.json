                  "21e"
                ],
                [
                  "last",
                  "dernier, dernière",
                  ""
                ]
              ]
            }
          ]
        },
        {
          "title": "Spelling",
          "blocks": [
            {
              "type": "text",
              "en": "A final *-e* drops: *quatre → quatrième, onze → onzième*. *Cinq* adds a *u*: *cinquième*. *Neuf* changes *f* to *v*: *neuvième*."
            }
          ]
        },
        {
          "title": "Where they are used",
          "blocks": [
            {
              "type": "text",
              "en": "Floors (*au troisième étage*), order (*la deuxième rue à droite*), the first time (*la première fois*). In dates only the first is an ordinal: *le premier mai*, but *le deux mai*."
            },
            {
              "type": "see",
              "rules": [
                "dates"
              ]
            }
          ]
        },
        {
          "title": "Examples",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "C'est la première fois.",
                  "en": "It's the first time."
                },
                {
                  "fr": "J'habite au cinquième étage.",
                  "en": "I live on the fifth floor."
                },
                {
                  "fr": "Prenez la deuxième rue à gauche.",
                  "en": "Take the second street on the left."
                },
                {
                  "fr": "Il est arrivé troisième.",
                  "en": "He came third."
                },
                {
                  "fr": "C'est le dernier jour des vacances.",
                  "en": "It's the last day of the holidays."
                }
              ]
            }
          ]
        }
      ],
      "checks": [
